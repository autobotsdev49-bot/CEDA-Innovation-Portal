# Next.js server. Copy to .env.local for local development.
# Configure real values in the Vercel environment when the web app is linked.
# Keep all secrets outside Git and out of the Expo bundle.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true when the return URL and verification email delivery have been tested.
CEDA_SIGNUP_ENABLED=false

# Server only. Enable each channel after its account and smoke test pass.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Expo uses its own environment with only public values.
# EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
