{
  "expo": {
    "name": "CEDA Innovation",
    "slug": "ceda-innovation-portal",
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.autobotsdev.cedainnovation",
      "supportsTablet": true,
      "icon": "./assets/ceda.png"
    },
    "android": {
      "package": "com.autobotsdev.cedainnovation",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ceda.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/ceda.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9A3D2B",
          "defaultChannel": "ceda-portal-updates"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a3bf111f-1239-4da0-80a0-7ab0ca917738"
      }
    },
    "owner": "jaycoder267",
    "icon": "./assets/ceda.png",
    "web": {
      "favicon": "./assets/ceda.png"
    }
  }
}
